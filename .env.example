# ==============================================================================
# JanSahayak / Government Scheme AI Assistant - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq Cloud High-Speed Inference (Primary LLM Engine)
# ------------------------------------------------------------------------------
# Supports single key or comma-separated pool for automatic key rotation on rate limits:
# Example: gsk_key1,gsk_key2
GROQ_API_KEY=your_groq_api_key_here

# Primary model for Router, Extractor, and Response Generation
# Recommended: openai/gpt-oss-20b or llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-20b

# Fast fallback model when primary model experiences latency or rate limits
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# LLM call timeout in seconds
LLM_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# 2. Agent Observability & Telemetry (Langfuse)
# ------------------------------------------------------------------------------
# Tracks agent traces, latency, step execution, and token usage
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# 3. Optional Alternative / Fallback LLM Providers
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
